MEGABYTE_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
MEGABYTE_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# Supabase deployment variables (keep the service role key private).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-with-the-publishable-anon-key
# Optional: store the SQLite database and private uploaded photos outside the project.
# MEGABYTE_DATA_DIR=D:\Megabyt\data
# PORT=3001
